# =============================
# i3 Base Config – Phase 1
# =============================

set $mod Mod4

font pango:JetBrainsMono Nerd Font 10

# Terminal
bindsym $mod+Return exec alacritty

# Launcher
bindsym Mod1+space exec rofi -show drun

# Kill focused window
bindsym $mod+q kill

# Reload / Restart i3
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Exit i3 (safe)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -b 'Yes' 'i3-msg exit'"

# Focus movement
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split orientation
bindsym $mod+v split v
bindsym $mod+b split h

# Fullscreen
bindsym $mod+f fullscreen toggle

# Layouts
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# --- Workspaces ---
set $ws1 "1:term"
set $ws2 "2:web"
set $ws3 "3:code"
set $ws4 "4:misc"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4

# Floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Bar (using polybar uncomment this to use the i3status bar)

# bar {
#    status_command i3status
# }

# --- GAPS ----
gaps inner 4
gaps outer 0
 
default_border pixel 3
default_floating_border pixel 2


# --- Window Rules ---
assign [class="Alacritty"] $ws1
assign [class="Firefox"] $ws2
assign [class="Brave-browser"] $ws2
assign [class="Code"] $ws3
assign [class="Thunar"] $ws4

# Floating windows
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="Nm-connection-editor"] floating enable

# --- Behavior ---
focus_follows_mouse no
mouse_warping none

floating_modifier $mod

# --- Polybar ---
exec_always --no-startup-id ~/.config/polybar/launch.sh

# --- Picom ---
exec --no-startup-id picom --config ~/.config/picom/picom.conf

# --- dunst ---
exec --no-startup-id dunst

# --- lock ---
bindsym $mod+x exec --no-startup-id betterlockscreen -l
bindsym $mod+p exec ~/.local/bin/powermenu

# --- feh ---
exec_always --no-startup-id ~/.local/bin/set-wallpaper

# --- Volume controls ---
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle


# --- Brightness controls ---
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# --- clipboard ---
exec --no-startup-id greenclip daemon
bindsym $mod+Shift+v exec --no-startup-id rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}'

# --- Change wallpaper ---
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/set-wallpaper
exec --no-startup-id ~/.local/bin/set-wallpaper


# --- File Manager ---
bindsym $mod+t exec thunar

# Screenshot - interactive
bindsym Print exec --no-startup-id flameshot gui

# Screenshot - full screen (save)
bindsym $mod+Print exec --no-startup-id flameshot full -p ~/Pictures/Screenshots

# Screenshot - full screen (clipboard)
bindsym Shift+Print exec --no-startup-id flameshot full -c

exec --no-startup-id flameshot

exec --no-startup-id xsettingsd &

exec --no-startup-id libinput-gestures-setup start

exec --no-startup-id blueman-applet" >> ~/.config/i3/config
