[global]
font = JetBrains Mono 10

width = 300
height = (0, 300)
offset = (20, 40)
origin = top-right

padding = 8
horizontal_padding = 10
frame_width = 2
frame_color = "#7aa2f7"
separator_color = frame
timeout = 4

[urgency_low]
background = "#0d0d0d"
foreground = "#eaeaea"

[urgency_normal]
background = "#0d0d0d"
foreground = "#eaeaea"

[urgency_critical]
background = "#ff5555"
foreground = "#ffffff"
timeout = 0
